# Node & Frontend Dependencies
node_modules/
.pnpm-store/
.npm/
package-lock.json.bak

# Frontend Build Outputs
dist/
dist-ssr/
frontend/dist/
*.local

# Python Environments & Virtual Environments
.venv/
venv/
env/
ENV/
backend/.venv/
*.venv/

# Python Bytecode & Compilations
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Machine Learning & Profiling Caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
backend/.env
frontend/.env

# Local Database Files & SQLite
*.db
*.sqlite
*.sqlite3
backend/app/database/*.db
backend/app/database/*.sqlite

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

