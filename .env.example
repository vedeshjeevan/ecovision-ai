# ====================================================================
# EcoVision AI - Environment Configuration
# ====================================================================

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Machine Learning Engine Configuration
MODEL_PATH=ml/saved_model/ecovision_model.keras
CLASS_INDICES_PATH=ml/saved_model/class_indices.json
MODEL_VERSION=1.0.0-mobilenetv2
CONFIDENCE_THRESHOLD=0.35

# Database Configuration (Supabase PostgreSQL)
# If SUPABASE_URL and SUPABASE_KEY are left blank, EcoVision AI automatically
# falls back to a high-performance local SQLite database engine (backend/app/database/ecovision.db)
# with identical tables and seed data, so you can run the entire app immediately!
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Frontend Configuration (for Vite)
VITE_API_BASE_URL=http://localhost:8000
